    suspicionChange: 0
    delayDuration: 10
  - stepID: D5_BugIncompleteExplain
    speakerName: The Protagonist
    personality: 0
    lineText: The previous action hasn't finished resolving yet. We handed control to the AI before checking its consequences.
    displayDuration: 3.5
    usePersonalitySkillVariant: 0
    highSkillThreshold: 3
    lowSkillText: 
    highSkillText: 
    choices: []
    nextStepID: D5_SFMLSteve
    awardSkillKey: 
    narrativeEventKey: 
    suppressZoomAcceptGreeting: 0
    suppressScreenShareVideo: 0
    stepType: 0
    suspicionChange: 0
    delayDuration: 10
  - stepID: D5_BugWrong
    speakerName: Steve
    personality: 0
    lineText: But the AI doesn't use SFML input.
    displayDuration: 2.5
    usePersonalitySkillVariant: 0
    highSkillThreshold: 3
    lowSkillText: 
    highSkillText: 
    choices: []
    nextStepID: D5_BugWrongThought
