  - stepID: D5_Steve_CheckEverywhere
    speakerName: Steve
    personality: 0
    lineText: So should I just keep adding if (!game_over) everywhere?
    displayDuration: 3
    usePersonalitySkillVariant: 0
    highSkillThreshold: 3
    lowSkillText: 
    highSkillText: 
    choices: []
    nextStepID: D5_SentinelAdvice
