    delayDuration: 10
  - stepID: D5_BugIncomplete
    speakerName: Steve
    personality: 0
    lineText: Right, but what's wrong with that place?
    displayDuration: 2.5
    usePersonalitySkillVariant: 0
    highSkillThreshold: 3
