    delayDuration: 10
  - stepID: D5_BugWrongThought
    speakerName: The Protagonist
    personality: 1
    lineText: He's asking distressingly good questions today.
    displayDuration: 2.4
    usePersonalitySkillVariant: 0
    highSkillThreshold: 3
    lowSkillText: 
    highSkillText: 
    choices: []
    nextStepID: D5_SFMLSteve
    awardSkillKey: 
