    delayDuration: 10
  - stepID: D5_SFMLSteve
    speakerName: Steve
    personality: 0
    lineText: So SFML basically tells us, "the mouse was clicked."
    displayDuration: 2.8
    usePersonalitySkillVariant: 0
    highSkillThreshold: 3
    lowSkillText: 
    highSkillText: 
    choices: []
    nextStepID: D5_SFMLProtagonist
    awardSkillKey: 
    narrativeEventKey: 
    suppressZoomAcceptGreeting: 0
    suppressScreenShareVideo: 0
    stepType: 0
    suspicionChange: 0
    delayDuration: 10
  - stepID: D5_SFMLProtagonist
    speakerName: The Protagonist
    personality: 0
    lineText: Right. SFML reports the input event. Our game decides whether the click is a legal attack and what happens afterward.
    displayDuration: 3.8
    usePersonalitySkillVariant: 0
    highSkillThreshold: 3
    lowSkillText: 
    highSkillText: 
    choices: []
    nextStepID: D5_TraceIntro
