    stepType: 0
    suspicionChange: 0
    delayDuration: 10
  - stepID: D5_TraceIntro
    speakerName: The Protagonist
    personality: 1
    lineText: Input. Resolve the action. Update state. Check whether the match ended. Then hand over the turn.
    displayDuration: 3.4
    usePersonalitySkillVariant: 0
    highSkillThreshold: 3
    lowSkillText: 
    highSkillText: 
    choices: []
