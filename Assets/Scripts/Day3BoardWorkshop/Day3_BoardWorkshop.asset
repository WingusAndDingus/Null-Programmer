      fileID: 0
  - stepID: D3_Complete
    speakerName: Me
    personality: 0
    lineText: Wednesday complete. The Board can place ships safely, and I can explain why. Tomorrow we can build
      on it.
    displayDuration: 4
    lineVariants: []
    choices: []
    nextStepID: D3_Night
    alternateNextStepID: ''
    awardSkillKey: ''
    narrativeEventKey: ''
    stepType: 0
    exerciseIndex: 0
    suspicionChange: 0
    delayDuration: 0
    NewSteveExpression: 0
    targetSceneName: Sleep
