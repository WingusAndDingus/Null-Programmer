    stepID: Day2_CellReview
    speakerName: The Architect
    personality: 2
    lineText: A familiar setup detail can make the conversation easier. It cannot replace the position calculation. One correct coordinate is useful; a rule that works for every coordinate is better.
    displayDuration: 10.7
    lineVariants: []
    choices: []
    nextStepID: Day2_Exercise_Loops
    alternateNextStepID: 
    awardSkillKey: 
    narrativeEventKey: 
