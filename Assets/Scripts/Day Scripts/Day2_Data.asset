      contactKey: friend
      contactName: Friend
      portrait: {fileID: 0}
      text: 
      replies: []
      waitForReply: 0
    stepID: Day2_Cell_Pragmatist
    speakerName: The Pragmatist
    personality: 3
    lineText: We only need this tile on the screen right now. We can choose how much of the calculation to tidy up before the demo.
    displayDuration: 8.9
    lineVariants: []
    choices: []
    nextStepID: Day2_Cell_Detective
    alternateNextStepID: 
    awardSkillKey: 
