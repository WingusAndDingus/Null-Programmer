      contactKey: friend
      contactName: Friend
      portrait: {fileID: 0}
      text: 
      replies: []
      waitForReply: 0
    stepID: Day2_Cell_Detective
    speakerName: The Detective
    personality: 6
    lineText: He knows yesterday's SFML setup. Recalling those details might reassure him, but they will not calculate this tile's position for us.
    displayDuration: 7.8
    lineVariants: []
    choices: []
    nextStepID: Day2_CellChoice
    alternateNextStepID: 
    awardSkillKey: 
    narrativeEventKey: 
